{
	"layer": "top",
	"position": "top",
	"mod" : "dock",
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,
	"height": 40,
	"margin": 10,
	"output": ["ASUSTek COMPUTER INC VG279Q3A S1LMTF140392", "CORSAIR MEMORY Inc. 45WQHD240 A2RIC31480J1"],

	// Import modules
	"include": [
		"~/.config/waybar/modules/workspaces.json",
		"~/.config/waybar/modules/language.json",
		"~/.config/waybar/modules/volume.json"
	],

	"modules-left": ["group/pill-left"],
	"modules-center": ["hyprland/window"],
	"modules-right": ["group/pill-right"],

	// Define pills
	"group/pill-left": {
		"orientation": "horizontal",
		"modules": ["hyprland/workspaces"],
	},

	"group/pill-right": {
		"orientation": "horizontal",
		"modules": ["pulseaudio", "hyprland/language", "clock#date", "clock", "tray"]
	},

	// Standard modules
	"hyprland/window": {
		"separate-outputs": true
	},

	"clock": {
        	"format": "{:%H:%M %p}",
        	"tooltip": false
    },

	// Date pill: hover for calendar, scroll = change month,
	// right-click = month/year view, middle-click = back to today
	"clock#date": {
		"format": "󰸗 {:%a %d %b}",
		"tooltip-format": "{calendar}",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"format": {
				"months":   "<span color='#cba6f7'><b>{}</b></span>",
				"days":     "<span color='#cdd6f4'>{}</span>",
				"weekdays": "<span color='#f9e2af'><b>{}</b></span>",
				"today":    "<span background='#cba6f7' color='#1e1e2e'><b>{}</b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-click-middle": "shift_reset",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}
